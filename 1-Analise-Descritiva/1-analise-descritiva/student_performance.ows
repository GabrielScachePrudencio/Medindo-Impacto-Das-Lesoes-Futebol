		<properties node_id="4" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\x02\x00\x00\x000\x00\x00\x02?\x00\x00\x02/\xff\xff\xff\x02\x00\x00\x00P\x00\x00\x02?\x00\x00\x02/\x00\x00\x00\x00\x00\x00\x00\x00\x03 \xff\xff\xff\x02\x00\x00\x00P\x00\x00\x02?\x00\x00\x02/', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import Orange\nimport numpy as np\nfrom scipy import stats\n\nindex = 0\nX = in_data.X\n\nfor variable in in_data.domain.variables:\n\n    var_name = variable.name\n    var_index = index\n    index += 1\n\n    if isinstance(variable, Orange.data.ContinuousVariable):\n\n        print("\\n &gt;&gt;&gt;&gt;&gt; ", var_name)\n        print( "mean()", X[ :, var_index ].mean() ) # média (medida de tendência central comum)\n        print( "std()", X[ :, var_index ].std() ) # desvio padrão (medida de dispersão, crucial, indicando o quão distantes os valores se encontram da média)\n        print( "std() / mean() %", X[ :, var_index ].std() / X[ :, var_index ].mean() * 100 ) # desvio padrão em relação a média em porcentagem\n        \n        print( "median()", np.median( X[ :, var_index ] ) ) # mediana (medida de tendência central, divide um conjunto de dados em duas partes iguais (na metade) :: 50% | 50%)\n        \n        q1 = np.percentile( X[ :, var_index ], 25 )  # 1 Quartil (25%) # quartil (medida de posição relativa, dispõe de três valores Q1, Q2 e Q3 que dividem os dados em quatro partes :: 25% | 25% | 25 % | 25% )\n        q2 = np.percentile( X[ :, var_index ], 50 )  # 2 Quartil (mediana, 50%)\n        q3 = np.percentile( X[ :, var_index ], 75 )  # 3 Quartil (75%)\n        print( "Q1", q1 )\n        print( "Q2", q2 )\n        print( "Q3", q3 )\n        \n        k = 0\n        score_z = ( X[ k, var_index ] - X[ :, var_index ].mean() ) / X[ :, var_index ].std() # escore z (medida de posição relativa, indica quantos desvios padrão um valor específico se encontra acima ou abaixo da média )\n        print( "score z da intância de dados k", X[ k, var_index ], score_z ) \n        \n        print( "skew()", stats.skew( X[ :, var_index ] ) ) # assimetria - skewness (medida de forma, indica como a distribuição de valores de uma variável desvia do seu ponto central, a média, quando positiva, a concentração de dados tende para a esquerda; caso seja negativa, tende para a direita)\n        \n        print( "kurtosis()", stats.kurtosis( X[ :, var_index ] ) ) # curtose - kurtosis (medida de forma, indica a forma do gráfico da distribuição de valores, zero apresenta um formato semelhante a distribuição normal, positivo apresenta formato mais afunilado (pico) e valores se encontram mais agrupados, negativo o ponto central da função é achatado e a dispersão dos valores é maior)\n\n    elif isinstance(variable, Orange.data.DiscreteVariable): pass\n    elif isinstance(variable, Orange.data.StringVariable): pass\n    else: pass\n', 'filename': None}], 'scriptText': 'import Orange\nimport numpy as np\nfrom scipy import stats\n\nindex = 0\nX = in_data.X\n\nfor variable in in_data.domain.variables:\n\n    var_name = variable.name\n    var_index = index\n    index += 1\n\n    if isinstance(variable, Orange.data.ContinuousVariable):\n\n        print("\\n &gt;&gt;&gt;&gt;&gt; ", var_name)\n        print( "mean()", X[ :, var_index ].mean() ) # média (medida de tendência central comum)\n        print( "std()", X[ :, var_index ].std() ) # desvio padrão (medida de dispersão, crucial, indicando o quão distantes os valores se encontram da média)\n        print( "std() / mean() %", X[ :, var_index ].std() / X[ :, var_index ].mean() * 100 ) # desvio padrão em relação a média em porcentagem\n        \n        print( "median()", np.median( X[ :, var_index ] ) ) # mediana (medida de tendência central, divide um conjunto de dados em duas partes iguais (na metade) :: 50% | 50%)\n        \n        q1 = np.percentile( X[ :, var_index ], 25 )  # 1 Quartil (25%) # quartil (medida de posição relativa, dispõe de três valores Q1, Q2 e Q3 que dividem os dados em quatro partes :: 25% | 25% | 25 % | 25% )\n        q2 = np.percentile( X[ :, var_index ], 50 )  # 2 Quartil (mediana, 50%)\n        q3 = np.percentile( X[ :, var_index ], 75 )  # 3 Quartil (75%)\n        print( "Q1", q1 )\n        print( "Q2", q2 )\n        print( "Q3", q3 )\n        \n        k = 0\n        score_z = ( X[ k, var_index ] - X[ :, var_index ].mean() ) / X[ :, var_index ].std() # escore z (medida de posição relativa, indica quantos desvios padrão um valor específico se encontra acima ou abaixo da média )\n        print( "score z da intância de dados k", X[ k, var_index ], score_z ) \n        \n        print( "skew()", stats.skew( X[ :, var_index ] ) ) # assimetria - skewness (medida de forma, indica como a distribuição de valores de uma variável desvia do seu ponto central, a média, quando positiva, a concentração de dados tende para a esquerda; caso seja negativa, tende para a direita)\n        \n        print( "kurtosis()", stats.kurtosis( X[ :, var_index ] ) ) # curtose - kurtosis (medida de forma, indica a forma do gráfico da distribuição de valores, zero apresenta um formato semelhante a distribuição normal, positivo apresenta formato mais afunilado (pico) e valores se encontram mais agrupados, negativo o ponto central da função é achatado e a dispersão dos valores é maior)\n\n    elif isinstance(variable, Orange.data.DiscreteVariable): pass\n    elif isinstance(variable, Orange.data.StringVariable): pass\n    else: pass\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xac\x00\x00\x00h\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
